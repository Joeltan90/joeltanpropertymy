{
  "name": "joeltanpropertymy",
  "version": "1.0.0",
  "private": true,
  "description": "Static property website with an isolated, read-only Supabase diagnostic",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:mobile": "node scripts/check-mobile.cjs",
    "supabase:check": "node --env-file-if-exists=.env.local scripts/check-supabase.cjs",
    "dev": "node --env-file=.env.local scripts/dev.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  }
}
